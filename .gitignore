# Mosaic Pro plugin source - licensed third-party code, never commit
mosaic/
mosaic-*/
mosaic.zip
mosaic-*.zip

# local capture artefacts
data/raw/*.local.json
*.pyc
__pycache__/
.DS_Store

# playwright scratch output
.playwright-mcp/
report.html
shots/web/_embed.json
__pycache__/

# Screenshots - 9.5MB of PNG/JPG that the skill itself does not need. The published
# report embeds its own copies; regenerate with tools/capture_live.py + build_report.py
shots/

# Raw capture dumps. data/*.csv is generated FROM these by tools/capture_live.py and
# is what the skill actually reads; the dumps are an intermediate, not a deliverable.
data/raw/

# Probe page specs used while developing the skill
designs/

# Client work - a real client's content and copy, not part of the skill
sites/_zidanna.py
sites/zidanna.json
# The agency's own site assembled from the converted pages: it enumerates a real
# page roster and real client case studies. The PATTERN is in
# references/dialog-and-triggers.md; the roster is not the skill's to publish.
sites/_moksaweb_site.py

# Drove designs/ and shots/, which no longer ship
tools/build_all.py
tools/build_report.py

# stray screenshots at the repo root
/*.png
/*.jpg

# npm
node_modules/
*.tgz
# an install test run inside the repo would land here
.claude/

# eval runs - reports and traces, regenerated by `claude plugin eval .`
evals/results/
# generated by python sites/_moksa.py - 2MB of built output, never tracked
sites/moksa.json
